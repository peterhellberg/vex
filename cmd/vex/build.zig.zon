.{
    .name = .vex_cmd,
    .version = "0.3.6",
    .fingerprint = 0xc03cd5ae12343a2f, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0-dev.387+31f157d80",
    .dependencies = .{
        .raylib = .{
            // Pinned to the official 6.0 release tag: vex uses only plain
            // window/input/2D/audio functionality, and since build.zig
            // compiles raylib's sources directly there is no reason to
            // track master for Zig-build compatibility.
            .url = "https://github.com/raysan5/raylib/archive/refs/tags/6.0.tar.gz",
            .hash = "raylib-6.0.0-whq8uCSwLgWWeF3ec3dbG6Rr36SLFL-s2WJ1Q_2E22Bb",
            .lazy = true,
        },
        // wasm3 is vendored into wasm3/ (pinned to the v0.9.0 release
        // tag) instead of fetched: the
        // project is dormant (no release since v0.5.0 in 2020, which lacks
        // the bulk-memory ops modern Zig carts need) and its build.zig
        // predates current Zig's Build API, so it can't load as a
        // dependency. Re-vendor from a new tag if one ever lands.
        .xcode_frameworks = .{
            .url = "https://pkg.machengine.org/xcode-frameworks/8a1cfb373587ea4c9bb1468b7c986462d8d4e10e.tar.gz",
            .hash = "N-V-__8AALShqgXkvqYU6f__FrA22SMWmi2TXCJjNTO1m8XJ",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "main.c",
        "test/tone_test.c",
        "wasm3",
    },
}
